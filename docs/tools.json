  {
    "name": "processes_list",
    "description": "Execution history across projects; statuses include FAILED. This is metadata, not console logs or stack traces. OAuth: https://www.googleapis.com/auth/script.processes.",
    "write": false,
    "scopes": ["https://www.googleapis.com/auth/script.processes"],
    "inputSchema": {
      "type": "object",
      "properties": {
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "pageToken": {
          "type": "string",
          "maxLength": 4096
        },
        "filter": {
          "type": "object",
          "properties": {
            "deploymentId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,256}$"
            },
            "functionName": {
              "type": "string",
              "maxLength": 1024
            },
            "startTime": {
              "type": "string",
              "format": "date-time"
            },
            "endTime": {
              "type": "string",
              "format": "date-time"
            },
            "statuses": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "RUNNING",
                  "PAUSED",
                  "COMPLETED",
                  "CANCELED",
                  "FAILED",
                  "TIMED_OUT",
                  "UNKNOWN",
                  "DELAYED"
                ]
              },
              "maxItems": 8
            },
            "scriptId": {
              "$ref": "#/properties/filter/properties/deploymentId"
            },
            "projectName": {
              "$ref": "#/properties/filter/properties/functionName"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "example": {
      "filter": {
        "statuses": ["FAILED"]
      }
    },
    "mockOutput": {
      "mode": "mock",
      "data": {
        "processes": [
          {
            "functionName": "ping",
            "processStatus": "COMPLETED",
            "processType": "EXECUTION_API",
            "duration": "0.1s"
          }
        ]
      }
    }
  },
