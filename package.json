{
  "name": "appsscript-mcp-http",
  "version": "3.0.0",
  "description": "Google Apps Script MCP Server \u2014 Streamable HTTP, broker-first auth (Connections Broker)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "format": "prettier --write src test docs README.md",
    "lint": "prettier --check src test docs README.md"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
