  {
    "name": "script_run",
    "description": "Run a function using deploymentId (API-executable deployment ID, not project ID); may change data. Legacy scriptId is an alias for that deployment ID. Requires the SAME standard GCP project as the OAuth client; token must cover ALL script scopes. No service accounts. devMode is for the script owner. A run can return Operation.error despite HTTP 200. OAuth: All OAuth scopes declared/used by the target script (no universal script.run scope). Requires APPS_SCRIPT_ENABLE_WRITES=true.",
    "write": true,
    "scopes": [
      "All OAuth scopes declared/used by the target script (no universal script.run scope)"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "deploymentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,256}$",
          "description": "API-executable deployment ID from Deploy > Manage deployments; required unless legacy scriptId alias is supplied"
        },
        "scriptId": {
          "$ref": "#/properties/deploymentId",
